# Copia a .env.staging y completa los valores. Nunca subas .env.staging a git.
# Genera claves con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

# --- Imagen (la publica el CI) ---
# develop = staging, latest = main
BACKEND_TAG=develop
API_PORT=8000

# --- Claves (obligatorias) ---
SECRET_KEY=
BIOMETRIC_ENCRYPTION_KEY=

# --- Entorno ---
DEBUG=False
# Dominio del túnel o servidor, separado por comas (ej: staging.midominio.com)
ALLOWED_HOSTS=localhost,127.0.0.1
# Origen de la web desplegada (ej: https://crhystel.github.io)
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=False
# True cuando se accede por HTTPS (túnel o proxy): activa redirección SSL y HSTS.
HTTPS_ONLY=False

# --- Admin de Django (superadmin) ---
ADMIN_URL=admin/
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
# Con HTTPS, el dominio del túnel o servidor (ej: https://staging.midominio.com)
CSRF_TRUSTED_ORIGINS=

# --- Base de datos (la crea el contenedor 'db' con estos valores) ---
DB_NAME=delycattessen_staging
DB_USER=delycattessen
DB_PASSWORD=
DB_CONN_MAX_AGE=60

# --- RabbitMQ (la cola corre en el mismo compose) ---
RABBITMQ_USER=delycattessen
RABBITMQ_PASSWORD=

# --- Email ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Pasarelas de pago: usar SOLO claves de sandbox/pruebas en staging ---
KUSHKI_PUBLIC_MERCHANT_ID=
KUSHKI_PRIVATE_MERCHANT_ID=
KUSHKI_WEBHOOK_SECRET=
KUSHKI_API_URL=https://api-uat.kushkipagos.com
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_API_URL=
PAYPHONE_RESPONSE_URL=
PAYPHONE_REDIRECT_BASE_URL=
PAYPHONE_ALLOWED_REDIRECT_HOSTS=
