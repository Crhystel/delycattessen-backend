# Copy to .env and fill in real values. Never commit .env.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

# --- Security keys (required) ---
SECRET_KEY=change-me
# Dedicated key for encrypted facial embeddings. If empty, SECRET_KEY is used.
BIOMETRIC_ENCRYPTION_KEY=change-me

# --- Environment (production values shown; for local development use
#     DEBUG=True, ALLOWED_HOSTS=*, CORS_ALLOW_ALL_ORIGINS=True) ---
DEBUG=False
ALLOWED_HOSTS=api.example.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://frontend.example.com
# Enables SSL redirect, secure cookies and HSTS. Only behind HTTPS.
HTTPS_ONLY=True

# --- Database ---
DB_NAME=delycattessen_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Seconds to reuse DB connections (0 = one connection per request; use 60 for local development).
DB_CONN_MAX_AGE=0

# --- Services ---
RABBITMQ_URL=amqp://user:password@localhost:5672//
# Optional shared cache; without it Django uses per-process memory.
REDIS_URL=redis://localhost:6379/1

# --- Email ---
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=change-me

# --- Payments ---
WALLET_RECHARGE_GATEWAY_THRESHOLD=5.00
KUSHKI_PUBLIC_MERCHANT_ID=change-me
KUSHKI_PRIVATE_MERCHANT_ID=change-me
KUSHKI_API_URL=https://api-uat.kushkipagos.com
PAYPHONE_TOKEN=change-me
PAYPHONE_STORE_ID=change-me
PAYPHONE_API_URL=https://pay.payphonetodoesposible.com/api
PAYPHONE_RESPONSE_URL=https://api.example.com/payphone/response
PAYPHONE_REDIRECT_BASE_URL=https://app.example.com/redirect
PAYPHONE_ALLOWED_REDIRECT_HOSTS=app.example.com
